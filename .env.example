# Backend: default SQLite is <repository>/geo.db when DATABASE_URL is omitted.
# Manual uvicorn: add --env-file .env or export these variables before launching.
# For PostgreSQL: docker compose --env-file .env up -d postgres
# URL-encode special characters in DATABASE_URL passwords.
# DATABASE_URL=postgresql+psycopg://geo:YOUR_URL_ENCODED_PASSWORD@127.0.0.1:5433/geo_platform
POSTGRES_PASSWORD=

# Set the same token on backend and Next server for protected deployments.
# Empty is localhost-only operator mode; protect the frontend too before remote exposure.
GEO_BACKEND_TOKEN=
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Razormind root URL, not /api/v1. Agent sampling runs only after explicit plan approval.
RAZORMIND_URL=
RAZORMIND_API_TOKEN=

# Real paid model capability. Starting an Agent run authorizes bounded model calls.
# Missing key/model makes agent-capabilities.ready false and start returns 503.
# Agent uses max_model_requests (default 8, hard maximum 12); no automatic billable retry.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=

# WordPress 5.6+ Application Password, never a browser cookie or login password.
# Existing pages/posts only. Publisher site_url must exactly match this root.
# HTTPS required except an explicitly allowlisted loopback protocol-test peer.
WORDPRESS_URL=
WORDPRESS_USERNAME=
WORDPRESS_APPLICATION_PASSWORD=
# Agent publishing also requires reviewed exact body/title/target and a frozen WP resource baseline.
# Background lifespan executor: 2-second queue poll, 300-second leases with 20-second heartbeat.
# Continuous maintenance defaults off; approved policy enables new due-time evidence/review runs, never auto-publication.

# Optional exact host:port overrides for controlled internal HTTP diagnostics.
# Empty rejects private/loopback/metadata by default. Never accept this from a client.
GEO_HTTP_ALLOWLIST=

# Next server only: browser talks to same-origin /api/backend/*.
GEO_API_URL=http://127.0.0.1:8000
